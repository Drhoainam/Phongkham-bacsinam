{
  "rewrites": [
    { "source": "/", "destination": "/phongkham.html" },
    { "source": "/don-thuoc", "destination": "/don-thuoc.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
